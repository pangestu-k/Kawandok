# Office AI Assistant - local development configuration template.
# Copy to repo-root .env (compose) or export variables for the apps.
# NEVER commit real credentials; this file must only contain placeholders.

# --- infra / docker-compose ---
POSTGRES_USER=migrator
POSTGRES_PASSWORD=dev_migrator_password
POSTGRES_DB=office_ai
POSTGRES_PORT=15432
REDIS_PORT=16379

# --- apps/api ---
API_ENV=dev
API_PORT=18080
API_LOG_LEVEL=info
API_DATABASE_URL=postgres://api:dev_api_password@127.0.0.1:15432/office_ai?sslmode=disable
API_REDIS_ADDR=127.0.0.1:16379
API_LLM_PROVIDER=mock
# Round-robin LLM (used when API_LLM_PROVIDER=robin): one entry per request,
# automatically failing over to the next model when one errors.
# Preferred form: token + model list per provider, interleaved so consecutive
# requests alternate providers (fill in your own keys; never commit them).
API_LLM_ROBIN_GROQ_BASE_URL=https://api.groq.com/openai/v1
API_LLM_ROBIN_GROQ_API_KEY=
API_LLM_ROBIN_GROQ_MODELS=openai/gpt-oss-120b,openai/gpt-oss-20b
API_LLM_ROBIN_GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
API_LLM_ROBIN_GEMINI_API_KEY=
API_LLM_ROBIN_GEMINI_MODELS=gemini-2.5-flash
# Alternative single-string form: base_url|api_key|model;base_url|api_key|model
API_LLM_ROBIN=
API_LLM_BASE_URL=
API_LLM_MODEL=
API_LLM_API_KEY=
API_RETRIEVAL_TOP_K=6
API_EMBEDDING_PROVIDER=mock
API_EMBEDDING_DIM=1536
API_EMBEDDING_BASE_URL=
API_EMBEDDING_MODEL=
API_EMBEDDING_API_KEY=

# Object storage: memory (dev default, files lost on restart) or s3 (R2-compatible)
API_STORAGE_BACKEND=s3
API_STORAGE_BUCKET=office-ai-dev
API_S3_ENDPOINT=http://127.0.0.1:19000
API_R2_ACCOUNT_ID=
API_R2_ACCESS_KEY_ID=dev
API_R2_SECRET_ACCESS_KEY=dev-secret
API_PRESIGN_TTL_SECONDS=60
API_MAX_UPLOAD_BYTES=26214400
API_DEV_SEED=true
# Development-only JWT. Generate a different 32+ character value per environment.
# This is never a production authentication mechanism; OIDC replaces it in M5.
API_JWT_ISSUER=office-ai-dev
API_JWT_AUDIENCE=office-ai-api
API_JWT_SIGNING_KEY=DwhcWoDm8pjxm9NebelJAJo9do67vILo
API_JWT_TTL_MINUTES=60

# --- apps/worker ---
WORKER_ENV=dev
WORKER_DATABASE_URL=postgres://worker:dev_worker_password@127.0.0.1:15432/office_ai?sslmode=disable
WORKER_REDIS_URL=redis://127.0.0.1:16379/0
WORKER_MAX_PAYLOAD_BYTES=1048576
WORKER_STREAM=office-ai:ingest:v1
WORKER_CONSUMER_GROUP=workers
WORKER_EMBEDDING_DIM=1536
WORKER_EMBEDDING_PROVIDER=mock
WORKER_EMBEDDING_BASE_URL=
WORKER_EMBEDDING_MODEL=
WORKER_EMBEDDING_API_KEY=
WORKER_CHUNK_TARGET_CHARS=1200
WORKER_CHUNK_OVERLAP_CHARS=150
WORKER_STORAGE_BACKEND=s3
WORKER_STORAGE_ENDPOINT=http://127.0.0.1:19000
WORKER_STORAGE_BUCKET=office-ai-dev
WORKER_STORAGE_ACCESS_KEY=dev
WORKER_STORAGE_SECRET_KEY=dev-secret
# Development defaults to disabled. Enable `clamav` before accepting real files.
WORKER_MALWARE_SCAN_MODE=disabled
WORKER_CLAMAV_HOST=127.0.0.1
WORKER_CLAMAV_PORT=3310
WORKER_CLAMAV_TIMEOUT_SECONDS=30

# --- apps/web (proxy /api -> API) ---
API_PROXY_TARGET=http://127.0.0.1:18080

# --- cloud object storage (Cloudflare R2). Leave empty in dev; never commit real values ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_DOCUMENTS=

# --- AI providers. Leave empty for mock providers; never commit real keys ---
LLM_PROVIDER_API_KEY=
EMBEDDING_PROVIDER_API_KEY=
