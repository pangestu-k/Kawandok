# Office AI Assistant - local development configuration template.
# Copy to repo-root .env (compose) or export variables for the apps.
# NEVER commit real credentials; this file must only contain placeholders.

# --- infra / docker-compose ---
POSTGRES_USER=migrator
POSTGRES_PASSWORD=dev_migrator_password
POSTGRES_DB=office_ai
POSTGRES_PORT=15432
REDIS_PORT=16379

# --- apps/api ---
API_ENV=dev
API_PORT=8080
API_LOG_LEVEL=info
API_DATABASE_URL=postgres://api:dev_api_password@127.0.0.1:15432/office_ai?sslmode=disable
API_REDIS_ADDR=127.0.0.1:16379
API_LLM_PROVIDER=mock
API_EMBEDDING_PROVIDER=mock
API_EMBEDDING_DIM=1536

# --- apps/worker ---
WORKER_ENV=dev
WORKER_DATABASE_URL=postgres://worker:dev_worker_password@127.0.0.1:15432/office_ai?sslmode=disable
WORKER_REDIS_URL=redis://127.0.0.1:16379/0
WORKER_MAX_PAYLOAD_BYTES=1048576

# --- cloud object storage (Cloudflare R2). Leave empty in dev; never commit real values ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_DOCUMENTS=

# --- AI providers. Leave empty for mock providers; never commit real keys ---
LLM_PROVIDER_API_KEY=
EMBEDDING_PROVIDER_API_KEY=
